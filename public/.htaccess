DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

# Protect historical submission logs and accidentally uploaded configuration.
<FilesMatch "(?i)(^\.|\.(log|ini|toml|bak|sql)$|^form-submissions\.txt$|^composer\.(json|lock)$)">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(css|js|jpg|png|webp|mp4)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# HTTPS enforcement and canonical www redirects are enabled during deployment
# only after Bluehost has renewed and verified the falbeybooks.com certificate.
