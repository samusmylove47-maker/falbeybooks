DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

# Canonical hostname. Bluehost enforces HTTPS; keep validation paths available.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{HTTP_HOST} ^www\.falbeybooks\.com$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/(acme-challenge|pki-validation)/ [NC]
  RewriteRule ^ https://falbeybooks.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Protect historical submission logs and accidentally uploaded configuration.
<FilesMatch "(?i)(^\.|\.(log|ini|toml|bak|sql)$|^error_log$|^form-submissions\.txt$|^composer\.(json|lock)$)">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(css|js|jpg|png|webp|mp4)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Bluehost's HTTPS enforcement and the site's SSL certificate are host-managed.
